<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base theme; Compose (ui/theme/Theme.kt) owns all real theming. This just sets the
         window background shown before Compose attaches, avoiding a white flash. -->
    <style name="Theme.GoPreach" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/splash_background</item>
        <item name="android:statusBarColor" tools:targetApi="21">@color/splash_background</item>
    </style>
</resources>
